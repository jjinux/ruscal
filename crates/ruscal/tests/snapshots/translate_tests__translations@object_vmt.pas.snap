//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program ObjectVmt;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Turbo Pascal gives an object with a constructor, a destructor or a
// virtual method a hidden 2-byte field, the address of its table of virtual
// methods (VMT). It follows the fields of the first type in the line to need
// one, before a descendant's own fields. SizeOf counts it, and so does a
// typed file. (Expected output by hand: 64-bit Free Pascal's VMT field is an
// 8-byte pointer. TP writes the VMT's address; Ruscal writes zeros.)
/// Pascal: `object X, Y: Integer; procedure Show; end`
#[derive(Clone, Copy, Debug, Default)]
struct TPlain {
    x: i16,
    y: i16,
}

impl TPlain {
    /// Pascal's `SizeOf(TPlain)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 2 + 2;
}

/// Pascal: `object X, Y: Integer; constructor Init; end`
#[derive(Clone, Copy, Debug, Default)]
struct TCtor {
    x: i16,
    y: i16,
}

impl TCtor {
    /// Pascal's `SizeOf(TCtor)`: its bytes in Turbo Pascal's layout.
    /// The last `2` is TP's hidden pointer to the object's virtual method table.
    pub const SERIALIZED_SIZE: usize = 2 + 2 + 2;
}

/// Pascal: `object X: Integer; destructor Done; end`
#[derive(Clone, Copy, Debug, Default)]
struct TDtor {
    x: i16,
}

impl TDtor {
    /// Pascal's `SizeOf(TDtor)`: its bytes in Turbo Pascal's layout.
    /// The last `2` is TP's hidden pointer to the object's virtual method table.
    pub const SERIALIZED_SIZE: usize = 2 + 2;
}

/// Pascal: `TShape = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct TShape {
    x: i16,
    y: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(TShape { x, y; vmt });

impl TShape {
    /// Pascal's `SizeOf(TShape)`: its bytes in Turbo Pascal's layout.
    /// The last `2` is TP's hidden pointer to the object's virtual method table.
    pub const SERIALIZED_SIZE: usize = 2 + 2 + 2;
}

/// Pascal: `object(TShape) R: Integer; procedure Draw; virtual; end`
#[derive(Clone, Copy, Debug, Default)]
struct TCircle {
    /// The inherited part: `TCircle` descends from `TShape`. Rust has no struct
    /// inheritance, so the parent object is embedded as a field, and inherited
    /// fields and methods are reached through it (`self.base.x`).
    base: TShape,
    r: i16,
}

file_record!(TCircle { base, r });

impl TCircle {
    /// Pascal's `SizeOf(TCircle)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = TShape::SERIALIZED_SIZE + 2;
}

/// Pascal: `object(TPlain) Z: Integer; constructor Init; end`
#[derive(Clone, Copy, Debug, Default)]
struct TPlainChild {
    base: TPlain,
    z: i16,
}

impl TPlainChild {
    /// Pascal's `SizeOf(TPlainChild)`: its bytes in Turbo Pascal's layout.
    /// The last `2` is TP's hidden pointer to the object's virtual method table.
    pub const SERIALIZED_SIZE: usize = TPlain::SERIALIZED_SIZE + 2 + 2;
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TPlain {
    /// Pascal: `procedure TPlain.Show;`
    fn show(&mut self) {}
}

impl TCtor {
    /// Pascal: `constructor TCtor.Init;`
    fn init(&mut self) {}
}

impl TDtor {
    /// Pascal: `destructor TDtor.Done;`
    fn done(&mut self) {}
}

impl TShape {
    /// Pascal: `constructor TShape.Init(AX, AY: Integer);`
    fn init(&mut self, ax: i16, ay: i16) {
        self.x = ax;
        self.y = ay;
    }
}

// Turbo Pascal finds a virtual method's version at run time, from the
// object's real type. Here each object type in the hierarchy has a trait
// like this one: its default methods are written once but run with `self`
// being the real object, so a call to a virtual method inside them goes to
// the right version. Each object implements the traits of its ancestors.
trait TShapeMethods {
    /// The `TShape` part of the object, for its fields.
    fn t_shape(&mut self) -> &mut TShape;
    fn draw(&mut self);

    /// Pascal: `procedure TShape.Draw;`
    fn t_shape_draw(&mut self) {
        pwriteln!("shape");
    }
}

impl TShapeMethods for TShape {
    fn t_shape(&mut self) -> &mut TShape {
        self
    }
    fn draw(&mut self) {
        self.t_shape_draw()
    }
}

trait TCircleMethods: TShapeMethods {
    /// The `TCircle` part of the object, for its fields.
    fn t_circle(&mut self) -> &mut TCircle;

    /// Pascal: `procedure TCircle.Draw;`
    fn t_circle_draw(&mut self) {
        pwriteln!("circle ", self.t_circle().base.x, " ", self.t_circle().base.y, " ", self.t_circle().r);
    }
}

impl TCircleMethods for TCircle {
    fn t_circle(&mut self) -> &mut TCircle {
        self
    }
}

impl TShapeMethods for TCircle {
    fn t_shape(&mut self) -> &mut TShape {
        &mut self.base
    }
    fn draw(&mut self) {
        self.t_circle_draw()
    }
}

impl TPlainChild {
    /// Pascal: `constructor TPlainChild.Init;`
    fn init(&mut self) {}
}

/// The main program: the `begin ... end.` block of `ObjectVmt`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PFile<TCircle> = PFile::default();
    let mut b: PFile<u8> = PFile::default();
    let mut c: TCircle = TCircle::default();
    let mut value: u8 = 0;
    pwriteln!(
        TPlain::SERIALIZED_SIZE,
        " ",
        TCtor::SERIALIZED_SIZE,
        " ",
        TDtor::SERIALIZED_SIZE,
        " ",
        TShape::SERIALIZED_SIZE,
        " ",
        TCircle::SERIALIZED_SIZE,
        " ",
        TPlainChild::SERIALIZED_SIZE
    );
    c.base.init(1, 2);
    c.r = 3;
    f.assign("object_vmt.dat");
    f.rewrite();
    f.write(&c);
    c.base.init(4, 5);
    c.r = 6;
    f.write(&c);
    pwriteln!(f.file_size());
    f.close();
    // The bytes: X, Y, the VMT field, then R.
    b.assign("object_vmt.dat");
    b.reset();
    while !b.eof() {
        b.read(&mut value);
        pwrite!(i16::from(value), " ");
    }
    pwriteln!();
    b.close();
    f.reset();
    f.seek(1);
    f.read(&mut c);
    c.draw();
    f.close();
    f.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
