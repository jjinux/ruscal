//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program WithViews;`
//! File: `with_views.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// with TRec(Data) do, where Data is an untyped parameter: each statement
// of the body reads the bytes and writes them back, so the body can only
// read, use two views or nest them, use Data directly or pass it on, take
// a field of the view, and leave with Break. Output from fpc -Mtp.

/// Pascal: `record A, B: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    a: i16,
    b: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(TRec { a, b });

/// Pascal: `record X, Y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TInner {
    x: i16,
    y: i16,
}

file_record!(TInner { x, y });

/// Pascal: `record Tag: Integer; Inner: TInner; end`
#[derive(Clone, Copy, Debug, Default)]
struct TOuter {
    tag: i16,
    inner: TInner,
}

file_record!(TOuter { tag, inner });

/// Pascal: `procedure Bump(var N: Integer);`
fn bump(n: &mut i16) {
    *n += 1;
}

/// Pascal: `procedure Fill(var D);`
fn fill(d: &mut dyn ByteView) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let mut d = Bytes::of(d);
    // Part of an untyped parameter seen as a `TRec`: its bytes are read into
    // `rsc_view`, which the statement changes, and written back after it.
    let mut rsc_view = d.read::<TRec>();
    rsc_view.b = rsc_view.a + 1;
    d.write(&rsc_view);
}

/// Pascal: `procedure ReadOnly(var Data);`
fn read_only(data: &mut dyn ByteView) {
    let data = Bytes::of(data);
    // Pascal `with`: Rust has no equivalent, so each field is written out in full.
    pwriteln!(data.read::<TRec>().a, " ", data.read::<TRec>().b);
}

/// Pascal: `procedure Two(var D1, D2);`
fn two(d1: &mut dyn ByteView, d2: &mut dyn ByteView) {
    let mut d1 = Bytes::of(d1);
    let mut d2 = Bytes::of(d2);
    let mut rsc_view = d2.read::<TRec>();
    rsc_view.a += 1;
    d2.write(&rsc_view);
    let mut rsc_view = d2.read::<TRec>();
    rsc_view.b += 10;
    d2.write(&rsc_view);
    let mut rsc_view = d1.read::<TRec>();
    rsc_view.a = 1;
    d1.write(&rsc_view);
    let mut rsc_view = d2.read::<TRec>();
    rsc_view.a = d1.read::<TRec>().a + 1;
    d2.write(&rsc_view);
    let mut rsc_view = d1.read::<TRec>();
    rsc_view.b = 7;
    d1.write(&rsc_view);
}

/// Pascal: `procedure Direct(var Data);`
fn direct(data: &mut dyn ByteView) {
    let mut data = Bytes::of(data);
    let mut rsc_view = data.read::<TRec>();
    rsc_view.a = 5;
    data.write(&rsc_view);
    pwriteln!(data.read::<TRec>().a, " ", data.read::<u16>());
    let mut rsc_view = data.read::<TRec>();
    rsc_view.b = 9;
    data.write(&rsc_view);
    fill(&mut data);
    pwriteln!(data.read::<TRec>().b);
}

/// Pascal: `procedure Field(var Data);`
fn field(data: &mut dyn ByteView) {
    let mut data = Bytes::of(data);
    let mut rsc_view = data.read::<TOuter>();
    rsc_view.inner.x = 1;
    data.write(&rsc_view);
    let mut rsc_view = data.read::<TOuter>();
    rsc_view.inner.y = rsc_view.inner.x + 1;
    data.write(&rsc_view);
    let mut rsc_view = data.read::<TOuter>();
    bump(&mut rsc_view.inner.y);
    data.write(&rsc_view);
}

/// Pascal: `procedure Leave(var Data);`
fn leave(data: &mut dyn ByteView) {
    let mut data = Bytes::of(data);
    for k in 1_i16..=5 {
        let mut rsc_view = data.read::<TRec>();
        rsc_view.a = k;
        data.write(&rsc_view);
        if k == 3 {
            break;
        }
        let mut rsc_view = data.read::<TRec>();
        rsc_view.b = k;
        data.write(&rsc_view);
    }
}

/// The main program: the `begin ... end.` block of `WithViews`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut r: TRec = TRec::default();
    let mut s: TRec = TRec::default();
    let mut o: TOuter = TOuter::default();
    r.a = 1;
    r.b = 308;
    read_only(&mut r);
    r.a = 1;
    r.b = 2;
    s.a = 3;
    s.b = 4;
    two(&mut r, &mut s);
    pwriteln!(r.a, " ", r.b, " ", s.a, " ", s.b);
    r.a = 1;
    r.b = 2;
    direct(&mut r);
    pwriteln!(r.a, " ", r.b);
    field(&mut o);
    pwriteln!(o.inner.x, " ", o.inner.y);
    r.a = 0;
    r.b = 0;
    leave(&mut r);
    pwriteln!(r.a, " ", r.b);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
