//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program TempNames;`
//! File: `temp_names.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Ruscal's temporaries start with rsc_, so a function named Index or
// Value doesn't clash with them; nor do Pascal names that start with
// Rsc_ themselves (a function Rsc_Index, a variable Rsc_I beside a for
// loop's I). Output from fpc -Mtp.

/// Pascal: `function Index(N: Integer): Integer;`
fn index(n: i16) -> i16 {
    n + 1
}

/// Pascal: `function Rsc_Index: Integer;`
fn rsc_index() -> i16 {
    2
}

/// Pascal: `function Value(N: Integer): Integer;`
fn value(n: i16) -> i16 {
    n * 10
}

/// The main program: the `begin ... end.` block of `TempNames`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut a: PArray<i16, 0, 10> = PArray::default();
    let mut i: i16 = 0;
    let mut rsc_i: i16 = 0;
    // `i` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for rsc_i_arg in 0..=9 {
        i = rsc_i_arg;
        a[i] = i;
    }
    let rsc_value = a[index(1)] + value(4);
    let rsc_index_arg = a[index(0)];
    a[rsc_index_arg] = rsc_value;
    pwriteln!(a[1], " ", a[2]);
    a[1] = 1;
    let rsc_index_arg = a[1];
    a[rsc_index_arg] = 3;
    pwriteln!(rsc_index(), " ", a[1]);
    rsc_i = 3;
    for rsc_i_arg in 1..=rsc_i {
        i = rsc_i_arg;
        pwrite!(rsc_i, " ");
    }
    pwriteln!(i);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
