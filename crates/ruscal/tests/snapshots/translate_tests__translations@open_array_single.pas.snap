//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program OpenArraySingle;`
//! File: `open_array_single.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A single value for an open array parameter, taken as a one-element
// array: TP 7 and fpc -Mtp refused it, so this output is written by
// hand. A computed value must be parenthesized in the Rust (&(i + 1)).

const NEG: i16 = -5;

/// Pascal: `procedure ShowB(const A: array of Byte);`
fn show_b(a: &OpenArray<u8>) {
    pwriteln!(a.high() as i16, " ", i16::from(a[0]));
}

/// Pascal: `procedure ShowI(A: array of Integer);`
fn show_i(a: &OpenArray<i16>) {
    pwriteln!(a.high() as i16, " ", a[0]);
}

/// Pascal: `procedure ShowL(A: array of LongInt);`
fn show_l(a: &OpenArray<i32>) {
    pwriteln!(a.high() as i16, " ", a[0]);
}

/// The main program: the `begin ... end.` block of `OpenArraySingle`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    i = 300;
    show_b(OpenArray::single(&255));
    show_b(OpenArray::single(&(2 + 3)));
    show_i(OpenArray::single(&(NEG * 2)));
    show_i(OpenArray::single(&(i + 1)));
    show_l(OpenArray::single(&(-2147483647 - 1)));
    show_l(OpenArray::single(&i32::from(i)));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
