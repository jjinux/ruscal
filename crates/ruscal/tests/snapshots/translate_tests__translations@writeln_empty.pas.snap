//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program WritelnEmpty;`
//! File: `writeln_empty.pas`

use ruscal_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `WritelnEmpty`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // WriteLn('') writes just a line break, so it's pwriteln!() in Rust, not
    // pwriteln!(""); the same for a text file.
    pwriteln!();
    pwriteln!("a", "b");
    pwrite!("");
    pwriteln!();
    pwriteln!("end");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
