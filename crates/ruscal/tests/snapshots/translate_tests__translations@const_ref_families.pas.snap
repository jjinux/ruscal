//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program ConstRefFamilies;`
//! File: `const_ref_families.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Const parameters Turbo Pascal passes by reference, in routines that
// share a signature or reach them indirectly: a procedural type's
// routines, a method called by a nested routine, and an object we hold as
// &mut dyn (a var parameter, Self in a virtual method) given to a const or
// value parameter. Expected output from Turbo Pascal 7 in DOSBox. (The
// $F+ directive: TP assigns only far routines to a procedural variable.)

/// Pascal: `object Count, Step, Limit: Integer; procedure Bump; end`
#[derive(Clone, Copy, Debug, Default)]
struct TCounter {
    count: i16,
    step: i16,
    limit: i16,
}

/// Pascal: `procedure(const C: TCounter)`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type TAct = ProcVar<fn(&mut TCounter)>;

/// Pascal: `TShape = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct TShape {
    x: i16,
    pad: PArray<i16, 1, 3>,
}

/// Pascal: `object(TShape) procedure Draw; virtual; end`
#[derive(Clone, Copy, Debug, Default)]
struct TCircle {
    /// The inherited part: `TCircle` descends from `TShape`. Rust has no struct
    /// inheritance, so the parent object is embedded as a field, and inherited
    /// fields and methods are reached through it (`self.base.x`).
    base: TShape,
}

/// Pascal: `procedure BumpIt(const C: TCounter);`
fn bump_it(c: &mut TCounter) {
    c.bump();
}

/// Pascal: `procedure ShowIt(const C: TCounter);`
fn show_it(c: &mut TCounter) {
    pwriteln!("count ", c.count);
}

/// Pascal: `procedure Twice(const C: TCounter; A: TAct);`
fn twice(c: &mut TCounter, a: TAct) {
    a.get()(c);
    a.get()(c);
}

/// Pascal: `procedure Outer(const C: TCounter);`
fn outer(c: &mut TCounter) {
    outer_inner(c);
}

/// Pascal: `procedure Inner;`
///
/// Nested inside `Outer` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn outer_inner(c: &mut TCounter) {
    c.bump();
}

/// Pascal: `procedure ShowX(const Sh: TShape);`
fn show_x(sh: &TShape) {
    pwriteln!("x ", sh.x);
}

/// Pascal: `procedure CopyX(Sh: TShape);`
fn copy_x(sh: TShape) {
    pwriteln!("copy ", sh.x);
}

/// Pascal: `procedure Paint(var Sh: TShape);`
fn paint(sh: &mut dyn TShapeMethods) {
    show_x(sh.t_shape());
    sh.draw();
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TCounter {
    /// Pascal: `procedure TCounter.Bump;`
    fn bump(&mut self) {
        self.count += self.step;
    }
}

impl TShape {
    /// Pascal: `constructor TShape.Init;`
    fn init(&mut self) {
        self.x = 5;
    }
}

// Turbo Pascal finds a virtual method's version at run time, from the
// object's real type. Here each object type in the hierarchy has a trait
// like this one: its default methods are written once but run with `self`
// being the real object, so a call to a virtual method inside them goes to
// the right version. Each object implements the traits of its ancestors.
trait TShapeMethods {
    /// The `TShape` part of the object, for its fields.
    fn t_shape(&mut self) -> &mut TShape;
    fn draw(&mut self);

    /// Pascal: `procedure TShape.Draw;`
    fn t_shape_draw(&mut self) {
        show_x(self.t_shape());
    }
}

impl TShapeMethods for TShape {
    fn t_shape(&mut self) -> &mut TShape {
        self
    }
    fn draw(&mut self) {
        self.t_shape_draw()
    }
}

trait TCircleMethods: TShapeMethods {
    /// The `TCircle` part of the object, for its fields.
    fn t_circle(&mut self) -> &mut TCircle;

    /// Pascal: `procedure TCircle.Draw;`
    fn t_circle_draw(&mut self) {
        self.t_circle().base.x = 7;
        show_x(self.t_shape());
        copy_x(*self.t_shape());
    }
}

impl TCircleMethods for TCircle {
    fn t_circle(&mut self) -> &mut TCircle {
        self
    }
}

impl TShapeMethods for TCircle {
    fn t_shape(&mut self) -> &mut TShape {
        &mut self.base
    }
    fn draw(&mut self) {
        self.t_circle_draw()
    }
}

/// The main program: the `begin ... end.` block of `ConstRefFamilies`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut counter: TCounter = TCounter::default();
    let mut act: TAct = TAct::nil();
    let mut circle: TCircle = TCircle::default();
    counter.step = 2;
    twice(&mut counter, TAct::of(bump_it, "BumpIt"));
    twice(&mut counter, TAct::of(show_it, "ShowIt"));
    act = TAct::of(bump_it, "BumpIt");
    act.get()(&mut counter);
    outer(&mut counter);
    show_it(&mut counter);
    circle.base.init();
    paint(&mut circle);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
