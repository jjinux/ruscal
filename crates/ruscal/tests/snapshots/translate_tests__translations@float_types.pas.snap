//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program FloatTypes;`
//! File: `float_types.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Single, Double and Extended under $N+ (TP 7, with the 8087): a Single
// keeps single precision, arithmetic is done in full precision, reals
// print with 15 digits, and a typed file stores 4, 8, 10 and 6 bytes.
// Expected output from Turbo Pascal 7 in DOSBox.

/// Pascal: `record S: Single; D: Double; E: Extended; R: Real; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    s: f32,
    d: f64,
    e: f64,
    r: f64,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(TRec { s, d: real 8, e: real 10, r });

impl TRec {
    /// Pascal's `SizeOf(TRec)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 4 + 8 + 10 + 6;
}

/// The main program: the `begin ... end.` block of `FloatTypes`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut s: f32 = 0.0;
    let mut d: f64 = 0.0;
    let e: f64 = 0.0;
    let r: f64 = 0.0;
    let mut l: i32 = 0;
    let mut i: i16 = 0;
    let mut code: i16 = 0;
    let mut rec: TRec = TRec::default();
    let mut f: PFile<TRec> = PFile::default();
    let mut b: PFile<u8> = PFile::default();
    let mut bt: u8 = 0;
    s = 0.1;
    d = 0.1;
    pwriteln!(s);
    pwriteln!(d);
    pwriteln!(wd(s, 0, 10), " ", wd(d, 0, 10), " ", w(s, 12), "|");
    pwriteln!(4, " ", 8, " ", 10, " ", 6, " ", TRec::SERIALIZED_SIZE);
    s = (1.0 / 3.0) as f32;
    d = f64::from(s);
    pwriteln!(wd(d, 0, 15));
    s = 16777216.0;
    s = (f64::from(s) + 1.0) as f32;
    pwriteln!(wd(s, 0, 1));
    l = 100007;
    s = l as f32;
    i = 7;
    // `{$N+}`: the 8087 rounds half to even (`Round(2.5)` is 2), as `round_ties_even` does.
    pwriteln!(
        s.round_ties_even() as i32,
        " ",
        (f64::from(s) + f64::from(i)).trunc() as i32,
        " ",
        wd(f64::from(s).powi(2), 0, 1),
        " ",
        wd(f64::from(s).sqrt(), 0, 3)
    );
    val("2.5", &mut s, &mut code);
    pwriteln!(wd(s, 0, 2), " ", code);
    rec.s = 1.5;
    rec.d = -2.25;
    rec.e = 15000000000.0;
    rec.r = 3.0;
    f.assign("FLOATS.DAT");
    f.rewrite();
    f.write(&rec);
    f.close();
    b.assign("FLOATS.DAT");
    b.reset();
    while !b.eof() {
        b.read(&mut bt);
        pwrite!(i16::from(bt), " ");
    }
    pwriteln!();
    b.close();
    f.reset();
    f.read(&mut rec);
    pwriteln!(wd(rec.s, 0, 2), " ", wd(rec.d, 0, 2), " ", rec.e, " ", wd(rec.r, 0, 1));
    f.close();
    f.erase();
}

fn main() {
    // `{$N+}`: reals print as Turbo Pascal 7 printed them with the 8087,
    // with 15 digits (` 1.50000000000000E+0000`).
    ruscal_runtime::io::use_coprocessor_format();
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
