//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program ReadableBits;`
//! File: `readable_bits.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

const MASK: i32 = 0xFF00;
const BACK: i16 = -0x10;

// Small readability points: a hex constant stays hex (0xFF00), an open
// array's High for a Byte loop is one cast (a.high() as u8), and a const
// string parameter, held as &PString, is used as it is where a reference
// does: printed, with a width, searched, compared, moved, Val'd.
/// Pascal: `(Red, Green, Blue)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum TColor {
    #[default]
    Red,
    Green,
    Blue,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for TColor {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for TColor {
    const VALUES: &'static [Self] = &[TColor::Red, TColor::Green, TColor::Blue];
}

/// Pascal: `procedure ShowAll(const A: array of Integer);`
fn show_all(a: &OpenArray<i16>) {
    for b in 0..=a.high() as u8 {
        pwrite!(a[b], " ");
    }
    pwriteln!();
}

/// Pascal: `procedure Use(const S: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn use_(buf: &mut PArray<u8, 1, 4>, n: &mut i16, code: &mut i16, s: &PString) {
    pwriteln!(s, "|", w(s, 8), "|", pos("l", s));
    if s == "hello" {
        pwriteln!("equal");
    }
    move_bytes(bytes_after(&string_view_bytes(s, 255), 1), buf, 4);
    val(s, n, code);
    pwriteln!(buf[1], buf[4], " ", *code);
}

/// The main program: the `begin ... end.` block of `ReadableBits`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut buf: PArray<u8, 1, 4> = PArray::default();
    let mut nums: PArray<i16, 1, 3> = PArray::default();
    let mut n: i16 = 0;
    let mut code: i16 = 0;
    let mut b: u8 = 0;
    pwriteln!(MASK & 0x0F00, " ", 0x10, " ", BACK);
    nums[1] = 1;
    nums[2] = 2;
    nums[3] = 3;
    show_all(nums.as_open());
    use_(&mut buf, &mut n, &mut code, &pstr("hello"));
    // A cast keeps the names in what it casts; a hex step or label stays
    // hex, a negative one too.
    b = TColor::Blue as u8;
    n = 3;
    n += 0x10;
    match n {
        -0x10 => pwriteln!("minus"),
        0x13 => pwriteln!("nineteen ", i16::from(b)),
        _ => {}
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
