//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program LendCalls;`
//! File: `lend_calls.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A statement that calls a routine changing a Char array, before it uses
// the array as a PChar: the routine runs first, so its change is seen and
// kept. And the statement's other reads of the array (Write, an element)
// see what it wrote through the PChar. Output from fpc -Mtp.

/// Pascal: `function Fill: Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn fill(buf: &mut PArray<u8, 0, 16>) -> i16 {
    // A Char array used as a PChar: Rust can't point into the array, so
    // the statement gets a copy of its characters, copied back after it
    // if it may change them.
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    str_copy(&rsc_buf_chars, &PChar::literal("filled"));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    1
}

/// Pascal: `function Direct: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn direct(buf: &mut PArray<u8, 0, 16>) -> i16 {
    buf[0] = b'D';
    2
}

/// The main program: the `begin ... end.` block of `LendCalls`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut buf: PArray<u8, 0, 16> = PArray::default();
    let n: i16 = 0;
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    str_copy(&rsc_buf_chars, &PChar::literal("start"));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    // `fill` may change an array this statement uses as a PChar, so it
    // runs before the array's characters are copied.
    let rsc_fill_result = fill(&mut buf);
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(rsc_fill_result, " ", str_pas(&rsc_buf_chars));
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    str_copy(&rsc_buf_chars, &PChar::literal("start"));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    let rsc_fill_result = fill(&mut buf);
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(rsc_fill_result, " ", str_len(&str_upper(&rsc_buf_chars)));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    pwriteln!(buf);
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    str_copy(&rsc_buf_chars, &PChar::literal("start"));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    let rsc_direct_result = direct(&mut buf);
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(rsc_direct_result, " ", str_len(&str_upper(&rsc_buf_chars)));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    pwriteln!(buf);
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    str_copy(&rsc_buf_chars, &PChar::literal("xyz"));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(
        "22 ",
        str_l_copy(&rsc_buf_chars, &PChar::literal("abcdef"), 2) == rsc_buf_chars,
        " [",
