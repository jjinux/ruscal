    str_copy(&rsc_buf_chars, &PChar::literal("hi"));
    rsc_buf_chars.copy_to(buf.as_mut_slice());
    let rsc_buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!("[", str_cat(&rsc_buf_chars, &PChar::literal("!")), "] [", w(&rsc_buf_chars, 5), "]");
