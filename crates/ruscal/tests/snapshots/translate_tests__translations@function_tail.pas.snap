//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program FunctionTail;`
//! File: `function_tail.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A function whose result is set only by its last statement: in the Rust
// the function ends with that value, with no `result` variable.

/// Pascal: `function Twice(N: Integer): Integer;`
fn twice(n: i16) -> i16 {
    n * 2
}

/// Pascal: `function Bigger(A, B: Integer): Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn bigger(i: &mut i16, a: i16, b: i16) -> i16 {
    if a > b {
        *i = a;
    } else {
        *i = b;
    }
    *i // the bigger one
}

/// Pascal: `function Clip(S: string): Short;`
fn clip(s: PString) -> PString {
    s.truncated(5)
}

/// Pascal: `function Checked(N: Integer): Integer;`
fn checked(n: i16) -> i16 {
    // `{$Q+}`: `checked_add` and the like give `None` when the result doesn't fit,
    // and `overflow` stops with runtime error 215, as in Turbo Pascal.
    n.checked_add(1).unwrap_or_else(overflow)
}

/// Pascal: `function Outer(N: Integer): Integer;`
fn outer(n: i16) -> i16 {
    outer_inner(n) * 2
}

/// Pascal: `function Inner: Integer;`
///
/// Nested inside `Outer` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn outer_inner(n: i16) -> i16 {
    n + 10
}

// Set in two places, or left by Exit: these keep their result variable.
/// Pascal: `function Sign(N: Integer): Integer;`
fn sign(n: i16) -> i16 {
    let mut result: i16 = 0;
    result = 0;
    if n > 0 {
        return result;
    }
    result = -1;
    result
}

/// Pascal: `function Digits(N: Integer): Integer;`
fn digits(mut n: i16) -> i16 {
    let mut result: i16 = 0;
    result = 1;
    while n > 9 {
        result = digits(n / 10) + 1;
        n = 0;
    }
    result
}

/// The main program: the `begin ... end.` block of `FunctionTail`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    pwriteln!(twice(21), " ", bigger(&mut i, 3, 7), " ", clip(pstr("abcdefgh")), " ", checked(41));
    pwriteln!(outer(1), " ", sign(5), " ", sign(-5), " ", digits(12345));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
