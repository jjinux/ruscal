//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program ObjectConstants;`
//! File: `object_constants.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Typed constants of object types (TP 7): fields, inherited ones too, as
// in a record constant; an object with virtual methods works without a
// constructor call, as TP filled in its VMT. Expected output from Turbo
// Pascal 7 in DOSBox.

/// Pascal: `object Count: Integer; procedure Bump; end`
#[derive(Clone, Copy, Debug, Default)]
struct TBase {
    count: i16,
}

impl TBase {
    /// Pascal's `SizeOf(TBase)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 2;
}

/// Pascal: `object(TBase) Step: Integer; procedure Show; virtual; end`
#[derive(Clone, Copy, Debug, Default)]
struct TKid {
    /// The inherited part: `TKid` descends from `TBase`. Rust has no struct
    /// inheritance, so the parent object is embedded as a field, and inherited
    /// fields and methods are reached through it (`self.base.x`).
    base: TBase,
    step: i16,
}

/// Pascal: `array[1..2] of TBase`
type TPair = PArray<TBase, 1, 2>;

// A typed constant keeps its value between calls.
/// Pascal: `procedure Tick;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn tick(t: &mut TBase) {
    t.bump();
    pwriteln!("Tick ", t.count);
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TBase {
    /// Pascal: `procedure TBase.Bump;`
    fn bump(&mut self) {
        self.count += 1;
    }
}

// Turbo Pascal finds a virtual method's version at run time, from the
// object's real type. Here each object type in the hierarchy has a trait
// like this one: its default methods are written once but run with `self`
// being the real object, so a call to a virtual method inside them goes to
// the right version. Each object implements the traits of its ancestors.
trait TBaseMethods {
    /// The `TBase` part of the object, for its fields.
    fn t_base(&mut self) -> &mut TBase;
}

impl TBaseMethods for TBase {
    fn t_base(&mut self) -> &mut TBase {
        self
    }
}

trait TKidMethods: TBaseMethods {
    /// The `TKid` part of the object, for its fields.
    fn t_kid(&mut self) -> &mut TKid;
    fn show(&mut self);

    /// Pascal: `procedure TKid.Show;`
    fn t_kid_show(&mut self) {
        pwriteln!("Kid ", self.t_kid().base.count, " ", self.t_kid().step);
    }
}

impl TKidMethods for TKid {
    fn t_kid(&mut self) -> &mut TKid {
        self
    }
    fn show(&mut self) {
        self.t_kid_show()
    }
}

impl TBaseMethods for TKid {
    fn t_base(&mut self) -> &mut TBase {
        &mut self.base
    }
}

/// The main program: the `begin ... end.` block of `ObjectConstants`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut k: TBase = TBase { count: 10 };
    let mut d: TKid = TKid { base: TBase { count: 5 }, step: 2 };
    // Fields left out at the end are 0.
    let mut no_step: TKid = TKid { base: TBase { count: 3 }, ..Default::default() };
    let mut pair: TPair = PArray::new([TBase { count: 1 }, TBase { count: 2 }]);
    let mut t: TBase = TBase { count: 100 };
    k.bump();
    d.base.bump();
    pwriteln!(k.count, " ", d.base.count, " ", d.step, " ", TBase::SERIALIZED_SIZE);
    d.show();
    no_step.show();
    pair[2].bump();
    pwriteln!(pair[1].count, " ", pair[2].count);
    tick(&mut t);
    tick(&mut t);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
