//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program IndexOrder;`
//! File: `index_order.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// The value of an assignment is worked out before the target's index, as
// in Turbo Pascal 7 (checked in DOSBox), also when the index goes into a
// let first; and an index that reads another field of the record, the
// stack idiom St.Items[St.Top], needs no let. A constant value needs no
// let either, and a value through a pointer gets just one. A procedural
// variable as the value is worked out first too (TP 7 prints 20 there:
// c/RUSCAL/IDXPROC.PAS).

/// Pascal: `array[1..5] of Integer`
type TArr = PArray<i16, 1, 5>;

/// Pascal: `record N: Integer; A: TArr; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    n: i16,
    a: TArr,
}

/// Pascal: `^TRec`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PRec = Ptr<TRec>;

/// Pascal: `function(N: Integer): Integer`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type TFn = ProcVar<fn(i16) -> i16>;

/// Pascal: `record Top: Integer; Items: array[1..10] of Char; end`
#[derive(Clone, Copy, Debug, Default)]
struct TStack {
    top: i16,
    items: PArray<u8, 1, 10>,
}

/// Pascal: `function SetN(var X: TRec): Integer;`
fn set_n(x: &mut TRec) -> i16 {
    x.n += 1;
    50
}

/// Pascal: `function Bump(var X: Integer): Integer;`
fn bump(x: &mut i16) -> i16 {
    *x += 1;
    *x
}

/// Pascal: `function Twice(N: Integer): Integer;`
fn twice(n: i16) -> i16 {
    n * 2
}

/// Pascal: `function Thrice(N: Integer): Integer;`
fn thrice(n: i16) -> i16 {
    n * 3
}

/// Pascal: `function Switch(var N: Integer): Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn switch(fv: &mut TFn, n: &mut i16) -> i16 {
    *n += 1;
    *fv = TFn::of(thrice, "Thrice");
    *n
}

/// Pascal: `procedure Show;`
///
/// Uses globals, which are passed in as parameters.
fn show(a: TArr) {
    for k in 1_i16..=5 {
        pwrite!(a[k], " ");
    }
    pwriteln!();
}

/// The main program: the `begin ... end.` block of `IndexOrder`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut a: TArr = TArr::default();
    let mut r: TRec = TRec::default();
    let mut st: TStack = TStack::default();
    let mut i: i16 = 0;
    let mut p: PRec = Ptr::nil();
    let mut chars: PArray<u8, 1, 4> = PArray::default();
    let mut funcs: PArray<TFn, 1, 3> = PArray::default();
    let mut fv: TFn = TFn::nil();
    // `i` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for rsc_i in 1..=5 {
        i = rsc_i;
        a[i] = i;
        r.a[i] = i;
    }
    r.n = 1;
    r.a[r.n] = set_n(&mut r);
    pwriteln!(r.a[1], " ", r.a[2], " ", r.n);
    let rsc_value = bump(&mut a[1]) + 10;
    let rsc_index = a[1];
    a[rsc_index] = rsc_value;
    show(a);
    a[1] = 1;
    let rsc_value = a[a[1]] + 100;
    let rsc_index = bump(&mut a[1]);
    a[rsc_index] = rsc_value;
    show(a);
    let rsc_index = a.low() as i16 + 1;
    a[rsc_index] = 9;
    let rsc_index = a.high() as i16 - 1;
    a[rsc_index] = 8;
    show(a);
    st.top = 0;
    st.top += 1;
    st.items[st.top] = b'x';
    st.top += 1;
    st.items[st.top] = b'y';
    pwriteln!(st.items[1], st.items[2], " ", st.top);
    i = 1;
    let rsc_index = bump(&mut i);
    chars[rsc_index] = b'q';
    let rsc_index = bump(&mut i);
    chars[rsc_index] = b'A';
    pwriteln!(chars[2], chars[3]);
    p = Ptr::alloc();
    p.get_mut().n = 1;
    for rsc_i in 1..=5 {
        i = rsc_i;
        p.get_mut().a[i] = 0;
    }
    let rsc_value = set_n(&mut *p.get_mut());
    let rsc_index = p.get().n;
    p.get_mut().a[rsc_index] = rsc_value;
    pwriteln!(p.get().a[1], " ", p.get().a[2], " ", p.get().n);
    p.dispose();
    fv = TFn::of(twice, "Twice");
    i = 0;
    let rsc_value = fv;
    let rsc_index = switch(&mut fv, &mut i);
    funcs[rsc_index] = rsc_value;
    pwriteln!(funcs[1].get()(10));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
