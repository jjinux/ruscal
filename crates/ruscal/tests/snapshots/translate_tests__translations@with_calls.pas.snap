// ===== src/main.rs =====
//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program WithCalls;`
//! File: `with_calls.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

// Each Pascal unit becomes a Rust module.
mod with_unit;

#[allow(unused_imports)]
use crate::with_unit::*;
#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// A with record chosen by a function call (with A[Slot] do, with Pick^ do,
// with Items[Next] do in a method, a procedural variable FV, IOResult, in a
// unit's initialization) is found once, before the body, as in Turbo
// Pascal: the function runs once, and every statement of the body means
// that record; with Pick^.Arr[Slot] runs Pick first. Output from
// fpc -Mtp.

/// Pascal: `record X, Y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    x: i16,
    y: i16,
}

/// Pascal: `^TRec`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PRec = Ptr<TRec>;

/// Pascal: `record Arr: array[1..3] of TRec; end`
#[derive(Clone, Copy, Debug, Default)]
struct TBox {
    arr: PArray<TRec, 1, 3>,
}

/// Pascal: `^TBox`
type PBox = Ptr<TBox>;

/// Pascal: `function: Integer`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type TSlotFn = ProcVar<fn(&mut i16) -> i16>;

/// Pascal: `TList = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct TList {
    count: i16,
    items: PArray<TRec, 1, 5>,
}

/// Pascal: `function Slot: Integer;`
///
/// Kept in a `TSlotFn`, so it takes the globals any `TSlotFn` routine uses.
fn slot_2(g: &mut i16) -> i16 {
    *g += 1;
    *g
}

/// Pascal: `function Pick: PRec;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn pick(g: &mut i16, ps: &PArray<PRec, 1, 3>) -> PRec {
    *g += 1;
    ps[*g].clone()
}

/// Pascal: `function PickBox: PBox;`
///
/// Uses globals, which are passed in as parameters.
fn pick_box(order: &mut PString, box_: &PBox) -> PBox {
    *order = *order + "P";
    box_.clone()
}

/// Pascal: `function Two: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn two(order: &mut PString) -> i16 {
    *order = *order + "S";
    2
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TList {
    /// Pascal: `function TList.Next: Integer;`
    fn next(&mut self) -> i16 {
        self.count += 1;
        self.count
    }

    /// Pascal: `procedure TList.Fill;`
    fn fill(&mut self) {
        let mut rsc_index: i16 = 0;
        // TP finds a `with` record once, before the body runs: its pointer (or an
        // index that calls a function) is worked out first, so the body means that
        // record even if it changes the pointer, and the function runs once.
        // Pascal `with`: Rust has no equivalent, so each field is written out in full.
        rsc_index = self.next();
        self.items[rsc_index].x = 7;
        self.items[rsc_index].y = 8;
    }
}

/// The main program: the `begin ... end.` block of `WithCalls`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut calls: i16 = 0;
    let mut cells: PArray<TCell, 1, 3> = PArray::default();
    let mut g: i16 = 0;
    let mut a: PArray<TRec, 1, 5> = PArray::default();
    let mut ps: PArray<PRec, 1, 3> = PArray::default();
    let mut l: TList = TList::default();
    let mut order: PString = PString::new();
    let mut box_: PBox = Ptr::nil();
    let mut fv: TSlotFn = TSlotFn::nil();
    let mut f: PText = PText::default();
    let mut rsc_index: i16 = 0;
    let mut rsc_index_2: i16 = 0;
    let mut t_rec: PRec = Ptr::nil();
    let mut t_box: PBox = Ptr::nil();
    let mut rsc_index_3: i16 = 0;
    let mut rsc_index_4: i16 = 0;
    let mut rsc_index_5: i16 = 0;
    // The initialization part of unit `WithUnit`.
    with_unit_init(&mut calls, &mut cells);
    for k in 1_i16..=5 {
        a[k].x = k;
        a[k].y = k * 10;
    }
    g = 0;
    rsc_index = slot_2(&mut g);
    pwriteln!(a[rsc_index].x, " ", a[rsc_index].y);
    pwriteln!(g);
    g = 0;
    rsc_index_2 = slot_2(&mut g);
    a[rsc_index_2].x = 100;
    a[rsc_index_2].y = 200;
    pwriteln!(g, " ", a[1].x, " ", a[1].y, " ", a[2].y);
    for k in 1_i16..=3 {
        ps[k] = Ptr::alloc();
        ps[k].get_mut().x = 0;
        ps[k].get_mut().y = 0;
    }
    g = 0;
    t_rec = pick(&mut g, &ps).clone();
    t_rec.get_mut().x = 5;
    t_rec.get_mut().y = 6;
    pwriteln!(g, " ", ps[1].get().x, " ", ps[1].get().y, " ", ps[2].get().y);
    l.count = 0;
    for k in 1_i16..=5 {
        l.items[k].x = 0;
        l.items[k].y = 0;
    }
    l.fill();
    pwriteln!(l.count, " ", l.items[1].x, " ", l.items[1].y, " ", l.items[2].y);
    pwriteln!(calls, " ", cells[1].x, " ", cells[1].y);
    box_ = Ptr::alloc();
    order = PString::new();
    t_box = pick_box(&mut order, &box_).clone();
    rsc_index_3 = two(&mut order);
    t_box.get_mut().arr[rsc_index_3].x = 1;
    t_box.get_mut().arr[rsc_index_3].y = 2;
    pwriteln!(order, " ", box_.get().arr[2].x, " ", box_.get().arr[2].y);
    for k in 1_i16..=5 {
        a[k].x = 0;
        a[k].y = 0;
    }
    g = 0;
    fv = TSlotFn::of(slot_2, "Slot");
    rsc_index_4 = fv.get()(&mut g);
    a[rsc_index_4].x = 1;
    a[rsc_index_4].y = 2;
    pwriteln!(g, " ", a[1].x, " ", a[1].y, " ", a[2].y);
    f.assign("no_such_dir_here/x.txt");
    // `{$I-}`: an I/O error in `io_unchecked` sets `IOResult` instead of
    // stopping the program.
    io_unchecked(|| f.reset());
    rsc_index_5 = io_result() - 1;
    a[rsc_index_5].x = 3;
    a[rsc_index_5].y = 4;
    pwriteln!(a[1].x, " ", a[1].y, " ", a[4].x, " ", a[4].y);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}

