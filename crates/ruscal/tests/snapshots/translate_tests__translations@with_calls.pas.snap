//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `unit WithUnit;`
//! File: `withunit.pas`

#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// For with_calls.pas: a with record chosen by a function call in a
// unit's initialization part.

/// Pascal: `record X, Y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
pub struct TCell {
    pub x: i16,
    pub y: i16,
}

/// Pascal: `function Slot: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn slot(calls: &mut i16) -> i16 {
    *calls += 1;
    *calls
}

/// The initialization part of unit `WithUnit`, run before the main program.
pub fn with_unit_init(calls: &mut i16, cells: &mut PArray<TCell, 1, 3>) {
    let mut rsc_index: i16 = 0;
    *calls = 0;
    rsc_index = slot(calls);
    cells[rsc_index].x = 3;
    cells[rsc_index].y = 4;
}
