//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program WithIndexOrder;`
//! File: `with_index_order.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// The order in which TP 7 works out a with record: the calls in its
// indexes first, from right to left (the last index of the last array
// first), and only then the pointer, so a call that changes the pointer
// (Swap) changes the record chosen. A variable index is read in its turn
// too: B[Bump, I] reads I before Bump changes it. Several records go left
// to right, each worked out before the next: with B[1, I], D[Bump, 1]
// reads I first, and with P^, C[Swap, 2] finds P before Swap changes it.
// Free Pascal goes left to right.
// Output from TP 7 (c/RUSCAL/WITHORD.PAS).

/// Pascal: `record X, Y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    x: i16,
    y: i16,
}

/// Pascal: `record Z: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TOther {
    z: i16,
}

/// Pascal: `^TBox`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PBox = Ptr<TBox>;

/// Pascal: `record Next: PBox; Arr: array[1..3] of TRec; end`
#[derive(Clone, Debug, Default)]
struct TBox {
    next: PBox,
    arr: PArray<TRec, 1, 3>,
}

/// Pascal: `function One: Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn one(order: &mut PString) -> i16 {
    *order = *order + "1";
    1
}

/// Pascal: `function Two: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn two(order: &mut PString) -> i16 {
    *order = *order + "2";
    2
}

/// Pascal: `function Three: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn three(order: &mut PString) -> i16 {
    *order = *order + "3";
    3
}

/// Pascal: `function Pick: PBox;`
///
/// Uses globals, which are passed in as parameters.
fn pick(ps: &PArray<PBox, 1, 3>, order: &mut PString) -> PBox {
    *order = *order + "P";
    ps[1].clone()
}

/// Pascal: `function Bump: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn bump(i: &mut i16) -> i16 {
    *i += 1;
    1
}

/// Pascal: `function Swap: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn swap(n2: &PBox, p: &mut PBox) -> i16 {
    *p = n2.clone();
    2
}

/// Pascal: `procedure Clear(Q: PBox);`
fn clear(q: PBox) {
    for k in 1_i16..=3 {
        q.get_mut().arr[k].x = 0;
        q.get_mut().arr[k].y = 0;
    }
}

/// The main program: the `begin ... end.` block of `WithIndexOrder`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut m: PArray<PArray<TRec, 1, 3>, 1, 3> = PArray::default();
    let mut b: PArray<PArray<TRec, 1, 3>, 1, 3> = PArray::default();
    let mut c: PArray<PArray<TRec, 1, 3>, 1, 3> = PArray::default();
    let mut d: PArray<PArray<TOther, 1, 3>, 1, 3> = PArray::default();
    let mut ps: PArray<PBox, 1, 3> = PArray::default();
