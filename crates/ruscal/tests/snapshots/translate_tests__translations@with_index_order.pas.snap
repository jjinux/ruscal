    let mut rsc_index_7: i16 = 0;
    let mut rsc_index_8: i16 = 0;
    let mut rsc_index_9: i16 = 0;
    let mut t_box_3: PBox = Ptr::nil();
    let mut rsc_index_10: i16 = 0;
    let mut t_box_4: PBox = Ptr::nil();
