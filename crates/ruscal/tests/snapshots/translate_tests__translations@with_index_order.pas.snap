    order = PString::new();
    rsc_index_3 = two(&mut order);
    rsc_index_4 = one(&mut order);
    t_box = ps[rsc_index_4].clone();
    t_box.get_mut().arr[rsc_index_3].x = 1;
    pwriteln!(order);
    order = PString::new();
    rsc_index_5 = two(&mut order);
    t_box_2 = pick(&ps, &mut order).clone();
    t_box_2.get_mut().arr[rsc_index_5].x = 1;
    pwriteln!(order);
    order = PString::new();
    rsc_index_6 = two(&mut order);
    rsc_index_7 = one(&mut order);
    rsc_index_8 = one(&mut order);
    rsc_index_9 = three(&mut order);
    t_box_3 = ps[rsc_index_9].clone();
    t_box_3.get_mut().arr[rsc_index_8].y = 1;
    pwriteln!(order);
    n1 = Ptr::alloc();
    n2 = Ptr::alloc();
    n1.get_mut().next = Ptr::alloc();
    n2.get_mut().next = Ptr::alloc();
    clear(n1.clone());
    clear(n2.clone());
    let rsc_q = n1.get().next.clone();
    clear(rsc_q);
    let rsc_q = n2.get().next.clone();
    clear(rsc_q);
    p = n1.clone();
    rsc_index_10 = swap(&n2, &mut p);
    t_box_4 = p.get().next.clone();
    t_box_4.get_mut().arr[rsc_index_10].x = 5;
    t_box_4.get_mut().arr[rsc_index_10].y = 6;
    pwriteln!(n1.get().next.get().arr[2].x, " ", n2.get().next.get().arr[2].x);
    p = n1.clone();
    rsc_index_11 = swap(&n2, &mut p);
    t_box_5 = p.clone();
    t_box_5.get_mut().arr[rsc_index_11].x = 7;
    if p.is_nil() {
        t_box_5.get_mut().arr[rsc_index_11].y = 8;
    }
    pwriteln!(n1.get().arr[2].x, " ", n2.get().arr[2].x);
    for k in 1_i16..=3 {
        for j in 1_i16..=3 {
            b[k][j].x = 0;
        }
    }
    i = 1;
    rsc_index_12 = i;
    rsc_index_13 = bump(&mut i);
    b[rsc_index_13][rsc_index_12].x = 9;
    pwriteln!(b[1][1].x, " ", b[1][2].x);
    for k in 1_i16..=3 {
        for j in 1_i16..=3 {
            c[k][j].y = 0;
            d[k][j].z = 0;
        }
    }
    i = 1;
    rsc_index_14 = i;
    rsc_index_15 = bump(&mut i);
    b[1][rsc_index_14].x = 4;
    d[rsc_index_15][1].z = 3;
    pwriteln!(b[1][1].x, " ", b[1][2].x, " ", d[1][1].z);
    p = n1.clone();
    t_box_6 = p.clone();
    rsc_index_16 = swap(&n2, &mut p);
    t_box_6.get_mut().next = Ptr::nil();
    c[rsc_index_16][3].y = 2;
    pwriteln!(n1.get().next.is_nil(), " ", n2.get().next.is_nil(), " ", c[2][3].y);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
