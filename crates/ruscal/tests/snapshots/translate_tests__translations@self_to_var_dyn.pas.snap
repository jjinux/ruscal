/// The main program: the `begin ... end.` block of `SelfToVarDyn`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut square: TSquare = TSquare::default();
    square.init();
    square.draw();
    pwriteln!(square.base.sides);
