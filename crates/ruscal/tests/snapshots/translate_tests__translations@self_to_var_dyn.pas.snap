// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Self passed to a var parameter of the object's type inside a virtual
// method: the parameter takes any descendant (&mut dyn in Rust), and Self
// there is the real object. Expected output from Turbo Pascal 7 in
// DOSBox.

/// Pascal: `TShape = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct TShape {
    sides: i16,
}

/// Pascal: `TSquare = object(TShape) ... end`
#[derive(Clone, Copy, Debug, Default)]
struct TSquare {
    /// The inherited part: `TSquare` descends from `TShape`. Rust has no struct
    /// inheritance, so the parent object is embedded as a field, and inherited
    /// fields and methods are reached through it (`self.base.x`).
    base: TShape,
}

/// Pascal: `procedure Paint(var Sh: TShape);`
fn paint(sh: &mut dyn TShapeMethods) {
    sh.t_shape().sides += 1;
    pwriteln!("paint ", sh.name(), " ", sh.t_shape().sides);
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TShape {
    /// Pascal: `constructor TShape.Init;`
    fn init(&mut self) {
        self.sides = 0;
    }
}

// Turbo Pascal finds a virtual method's version at run time, from the
// object's real type. Here each object type in the hierarchy has a trait
// like this one: its default methods are written once but run with `self`
// being the real object, so a call to a virtual method inside them goes to
// the right version. Each object implements the traits of its ancestors.
trait TShapeMethods {
    /// The `TShape` part of the object, for its fields.
    fn t_shape(&mut self) -> &mut TShape;
    /// The object as a `&mut dyn TShapeMethods`, which a default method can't make
    /// of `self` itself (it doesn't know the type is sized): for passing
    /// `Self` to a `var` parameter of type `TShape`.
    fn as_t_shape_dyn(&mut self) -> &mut dyn TShapeMethods;
    fn draw(&mut self);
    fn name(&mut self) -> PString;

    /// Pascal: `procedure TShape.Draw;`
    fn t_shape_draw(&mut self) {
        paint(self.as_t_shape_dyn());
    }

    /// Pascal: `function TShape.Name: string;`
    fn t_shape_name(&mut self) -> PString {
        let mut result: PString = PString::new();
        result = pstr("shape");
        result
