        self
    }
    fn as_t_shape_dyn(&mut self) -> &mut dyn TShapeMethods {
        self
    }
    fn draw(&mut self) {
        self.t_shape_draw()
    }
    fn name(&mut self) -> PString {
        self.t_shape_name()
    }
}

impl TSquare {
    /// Pascal: `constructor TSquare.Init;`
    fn init(&mut self) {
        self.base.sides = 4;
    }
}

trait TSquareMethods: TShapeMethods {
    /// The `TSquare` part of the object, for its fields.
    fn t_square(&mut self) -> &mut TSquare;

    /// Pascal: `procedure TSquare.Draw;`
    fn t_square_draw(&mut self) {
        paint(self.as_t_shape_dyn());
        self.t_shape_draw();
