// ===== src/main.rs =====
//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program NPMix;`
//! File: `npmix.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

// Each Pascal unit becomes a Rust module.
mod np_unit;
mod np_unit2;
mod sft_unit;

#[allow(unused_imports)]
use crate::np_unit::*;
#[allow(unused_imports)]
use crate::np_unit2::*;
#[allow(unused_imports)]
use crate::sft_unit::*;
#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// A program without $N+ using units with and without it: each prints
// reals its own way, as in Turbo Pascal 7 (checked in DOSBox).

/// The main program: the `begin ... end.` block of `NPMix`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut r: f64 = 0.0;
    r = 1.5;
    pwriteln!(r, "|", w(r, 12));
    show(r);
    show_soft(r);
    twice(r);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}

// ===== src/np_unit.rs =====
//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `unit NPUnit;`
//! File: `npunit.pas`

#[allow(unused_imports)]
use crate::np_unit2::*;
#[allow(unused_imports)]
use crate::sft_unit::*;
#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// A unit compiled with $N+: its reals print the 8087's way, whatever
// the program's setting (npmix.pas), as in Turbo Pascal 7.

/// Pascal: `procedure Show(X: Real);`
pub fn show(x: f64) {
    let mut s: PString = PString::new();
    // This unit is compiled with `{$N+}`, unlike the program: its reals print its way.
    s = pas_str(coprocessor_format(x));
    pwriteln!(
        coprocessor_format(x),
        "|",
        w(coprocessor_format(x), 12),
        "|",
        s,
        "|",
        wd(x, 0, 3),
        "|",
        2.5_f64.round() as i32
    );
}

// ===== src/sft_unit.rs =====
//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `unit SftUnit;`
//! File: `sftunit.pas`

#[allow(unused_imports)]
use crate::np_unit::*;
#[allow(unused_imports)]
use crate::np_unit2::*;
#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// A unit compiled without $N+: its reals print the software way, even
// in an $N+ program (npmix2.pas), as in Turbo Pascal 7.

/// Pascal: `procedure ShowSoft(X: Real);`
pub fn show_soft(x: f64) {
    let mut s: PString = PString::new();
    s = pas_str(w(x, 12));
    pwriteln!(x, "|", s, "|", 2.5_f64.round() as i32);
}

// ===== src/np_unit2.rs =====
//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `unit NPUnit2;`
//! File: `npunit2.pas`

#[allow(unused_imports)]
use crate::np_unit::*;
#[allow(unused_imports)]
use crate::sft_unit::*;
#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// A second unit compiled with $N+: its module explains the wrapper too.

/// Pascal: `procedure Twice(X: Real);`
pub fn twice(x: f64) {
    // This unit is compiled with `{$N+}`, unlike the program: its reals print its way.
    pwriteln!(coprocessor_format(2.0 * x));
}
