//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program IndexCalls;`
//! File: `index_calls.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// An index that calls a function: in an assignment's target it's worked
// out first (Pick reads the array the target indexes), on both sides it
// runs twice, the value's call first, as in Turbo Pascal 7 (checked in
// DOSBox; Free Pascal calls the target's first), and in a method an index that
// calls a method reads fine. The same goes for other places that are
// written: Inc, and a var argument.
/// Pascal: `Bag = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct Bag {
    items: PArray<u8, 1, 3>,
    n: i16,
}

/// Pascal: `function Pick: Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn pick(arr: PArray<i16, 1, 3>) -> i16 {
    arr[1]
}

/// Pascal: `function Next: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn next(calls: &mut i16) -> i16 {
    *calls += 1;
    *calls
}

/// Pascal: `procedure Touch(var v: Integer);`
fn touch(v: &mut i16) {
    *v += 100;
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl Bag {
    /// Pascal: `procedure Bag.Init;`
    fn init(&mut self) {
        self.items[1] = b'x';
        self.items[2] = b'y';
        self.items[3] = b'z';
        self.n = 2;
    }

    /// Pascal: `function Bag.Count: Integer;`
    fn count(&mut self) -> i16 {
        self.n
    }

    /// Pascal: `function Bag.Last: Char;`
    fn last(&mut self) -> u8 {
        let rsc_index = self.count();
        self.items[rsc_index]
    }

    /// Pascal: `procedure Bag.Grow;`
    fn grow(&mut self) {
        let rsc_index = self.count();
        self.items[rsc_index] += 1;
    }
}

/// The main program: the `begin ... end.` block of `IndexCalls`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut arr: PArray<i16, 1, 3> = PArray::default();
    let mut counts: PArray<i16, 1, 3> = PArray::default();
    let mut calls: i16 = 0;
    let mut b: Bag = Bag::default();
    arr[1] = 2;
    arr[2] = 0;
    arr[3] = 0;
    let rsc_index = pick(arr);
    arr[rsc_index] = 7;
    pwriteln!(arr[1], " ", arr[2], " ", arr[3]);
    counts[1] = 0;
    counts[2] = 0;
    counts[3] = 0;
    calls = 0;
    let rsc_value = counts[next(&mut calls)] + 5;
    let rsc_index = next(&mut calls);
    counts[rsc_index] = rsc_value;
    pwriteln!(counts[1], " ", counts[2], " ", counts[3], " ", calls);
    b.init();
    pwriteln!(b.last());
    b.grow();
    pwriteln!(b.last());
    let rsc_index = pick(arr);
    arr[rsc_index] += 1;
    let rsc_index = pick(arr);
    touch(&mut arr[rsc_index]);
    pwriteln!(arr[1], " ", arr[2], " ", arr[3]);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
