//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program SizeOfMore;`
//! File: `sizeof_more.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// SizeOf(Rec) keeps its name in the Rust wherever it's used: runtime
// routines' counts, overflow-checked arithmetic, reals, a minus sign, an
// index and in. Output from fpc -Mtp.

/// Pascal: `record X, Y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Point {
    x: i16,
    y: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Point { x, y });

impl Point {
    /// Pascal's `SizeOf(Point)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 2 + 2;
}

/// Pascal: `record N: Integer; P: Point; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    n: i16,
    p: Point,
}

file_record!(Rec { n, p });

impl Rec {
    /// Pascal's `SizeOf(Rec)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = 2 + Point::SERIALIZED_SIZE;
}

/// Pascal: `array[1..300] of Byte`
type Big = PArray<u8, 1, 300>;

/// The main program: the `begin ... end.` block of `SizeOfMore`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    let mut r: f64 = 0.0;
    let mut a: PArray<u8, 1, 20> = PArray::default();
    let mut s: PSet<u8> = PSet::new();
    let small: PSet<i8> = PSet::new();
    let mut f: PBlockFile = PBlockFile::default();
    let mut p: AnyPtr = AnyPtr::nil();
    let mut b: Rec = Rec::default();
    i = 3;
    // `{$Q+}`: `checked_add` and the like give `None` when the result doesn't fit,
    // and `overflow` stops with runtime error 215, as in Turbo Pascal.
    j = (Rec::SERIALIZED_SIZE as i16).checked_mul(i).unwrap_or_else(overflow);
    pwriteln!(j);
    j = (Rec::SERIALIZED_SIZE as i16 + Point::SERIALIZED_SIZE as i16).checked_mul(i).unwrap_or_else(overflow);
    pwriteln!(j);
    j = (-(Rec::SERIALIZED_SIZE as i16)).checked_mul(i).unwrap_or_else(overflow);
    pwriteln!(j);
    r = Rec::SERIALIZED_SIZE as f64;
    pwriteln!(wd(r, 0, 1));
    r = Rec::SERIALIZED_SIZE as f64 / 4.0;
    pwriteln!(wd(r, 0, 2));
    r = f64::from(Rec::SERIALIZED_SIZE as i16 * 2);
    pwriteln!(wd(r, 0, 1));
    r = Rec::SERIALIZED_SIZE as f64 * 1.5;
    pwriteln!(wd(r, 0, 1));
    pwriteln!(-(Rec::SERIALIZED_SIZE as i16));
    a[Point::SERIALIZED_SIZE as i16 + 1] = 7;
    pwriteln!(i16::from(a[5]));
    s = pset![6];
    pwriteln!(s.contains(Rec::SERIALIZED_SIZE as i16), " ", small.contains(300));
    b.n = 1;
    b.p.x = 2;
    b.p.y = 3;
    f.assign("sznames.dat");
    f.rewrite_records(1);
    f.block_write(&b.to_bytes(), Rec::SERIALIZED_SIZE as u16);
    f.block_write(&b.to_bytes(), i.checked_mul(Rec::SERIALIZED_SIZE as i16).unwrap_or_else(overflow) / 3);
    f.seek(Rec::SERIALIZED_SIZE as i32);
    pwriteln!(f.file_size(), " ", f.file_pos());
    f.close();
    f.erase();
    p = AnyPtr::alloc(10 * Rec::SERIALIZED_SIZE as u16);
    p.free();
    fill_bytes(&mut a, Point::SERIALIZED_SIZE as u16, 0);
    move_bytes(&b.to_bytes(), &mut a, Rec::SERIALIZED_SIZE as u16);
    pwriteln!(i16::from(a[1]), i16::from(a[3]), i16::from(a[5]));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
