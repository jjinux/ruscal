//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program TypedFileCast;`
//! File: `typed_file_cast.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Write to a typed file takes a typecast variable of the same size, as in
// Turbo Pascal 7: an Integer, an untyped parameter, a string's
// character.

/// Pascal: `procedure WriteBytes(var Data);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn write_bytes(f: &mut PFile<u16>, data: &mut dyn ByteView) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let data = Bytes::of(data);
    f.write(&data.read::<u16>());
}

/// The main program: the `begin ... end.` block of `TypedFileCast`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PFile<u16> = PFile::default();
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    let mut fb: PFile<u8> = PFile::default();
    let mut s: PString = PString::new();
    let mut b: u8 = 0;
    let mut b2: u8 = 0;
    f.assign("tfcast.dat");
    f.rewrite();
    i = -1;
    f.write(&(i as u16));
    f.reset();
    f.read(&mut w_);
    pwriteln!(w_, " ", f.file_size());
    w_ = 40;
    f.seek(0);
    write_bytes(&mut f, &mut w_);
    f.seek(0);
    f.read(&mut w_);
    pwriteln!(w_);
    f.close();
    f.erase();
    fb.assign("tfcastb.dat");
    fb.rewrite();
    s = pstr("A");
    fb.write(&s[1]);
    fb.write(&s[0]);
    fb.reset();
    fb.read(&mut b);
    fb.read(&mut b2);
    pwriteln!(i16::from(b), " ", i16::from(b2));
    fb.close();
    fb.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
