// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(enum TBig);

/// Pascal: `record Part: TPart; Whole: TBig; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    part: TBig,
    whole: TBig,
}

file_record!(TRec { part: enum 1, whole });

impl TRec {
    /// Pascal's `SizeOf(TRec)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 1 + 2;
}

/// The main program: the `begin ... end.` block of `EnumSubrangeBytes`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let f: PFile<TBig> = PFile::sized(1);
    let g: PFile<TRec> = PFile::default();
    let mut r: TRec = TRec::default();
    let mut n: i16 = 0;
    n = TRec::SERIALIZED_SIZE as i16;
    r.part = TBig::V15;
    pwriteln!(n, " ", r.part as i16);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
