//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program ConstByReference;`
//! File: `const_by_reference.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A const parameter Turbo Pascal passes by reference is a reference in
// Rust: &PString for a string, &TBig for a record of more than 4 bytes
// (a 4-byte one is copied), &mut TCounter when a method is called on it
// or it's passed on to such a parameter, and &mut too when the routine
// changes the global every call passes, which it then reads through the
// parameter.
/// Pascal: `record A, B: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TSmall {
    a: i16,
    b: i16,
}

/// Pascal: `record A, B, C: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TBig {
    a: i16,
    b: i16,
    c: i16,
}

/// Pascal: `object Count, Step, Limit: Integer; procedure Bump; end`
#[derive(Clone, Copy, Debug, Default)]
struct TCounter {
    count: i16,
    step: i16,
    limit: i16,
}

/// Pascal: `procedure Greet(const S: string);`
fn greet(s: &PString) {
    pwriteln!("hello, ", s);
}

/// Pascal: `function Total(const X: TBig; const Y: TSmall): Integer;`
fn total(x: &TBig, y: TSmall) -> i16 {
    let mut result: i16 = 0;
    result = x.a + x.b + x.c + y.a + y.b;
    result
}

/// Pascal: `procedure BumpIt(const C: TCounter);`
fn bump_it(c: &mut TCounter) {
    c.bump();
}

/// Pascal: `procedure PassOn(const C: TCounter);`
fn pass_on(c: &mut TCounter) {
    bump_it(c);
}

/// Pascal: `procedure Reset(const X: TBig);`
///
/// Every call passes `Big` itself as `X`, so where the Pascal code
/// uses `Big` directly, this function uses `X`: they are the same
/// variable, and Rust doesn't allow two references to one variable.
/// (Turbo Pascal passes the `const` `X` by reference, so a change to
/// `Big` here shows through it, which is why it's `&mut`.)
fn reset(x: &mut TBig) {
    x.a = 0;
    pwriteln!(x.a);
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TCounter {
    /// Pascal: `procedure TCounter.Bump;`
    fn bump(&mut self) {
        self.count += self.step;
    }
}

/// The main program: the `begin ... end.` block of `ConstByReference`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut name: PString = PString::new();
    let mut small: TSmall = TSmall::default();
    let mut big: TBig = TBig::default();
    let mut counter: TCounter = TCounter::default();
    name = pstr("world");
    greet(&name);
    greet(&pstr("there"));
    greet(&(name + "!"));
    big.a = 1;
    small.a = 2;
    pwriteln!(total(&big, small));
    counter.step = 5;
    bump_it(&mut counter);
    pass_on(&mut counter);
    pwriteln!(counter.count);
    reset(&mut big);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
