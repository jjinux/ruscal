//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program RoundNPlus;`
//! File: `round_n_plus.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Under $N+ the 8087 rounds half to even at run time, for every real
// type (Round(2.5) is 2, Round(-2.5) is -2, Round(0.5) is 0); a
// constant Round(2.5) is still 3, worked out by the compiler. Expected
// output from Turbo Pascal 7 in DOSBox.

/// The main program: the `begin ... end.` block of `RoundNPlus`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut r: f64 = 0.0;
    let mut d: f64 = 0.0;
    let mut e: f64 = 0.0;
    let mut s: f64 = 0.0;
    r = 2.5;
    d = 2.5;
    e = 2.5;
    s = 2.5;
    // `{$N+}`: the 8087 rounds half to even (`Round(2.5)` is 2), as `round_ties_even` does.
    pwriteln!(
        r.round_ties_even() as i32,
        " ",
        d.round_ties_even() as i32,
        " ",
        e.round_ties_even() as i32,
        " ",
        s.round_ties_even() as i32,
        " ",
        2.5_f64.round() as i32
    );
    r = -2.5;
    d = 0.5;
    e = 3.5;
    pwriteln!(
        r.round_ties_even() as i32,
        " ",
        d.round_ties_even() as i32,
        " ",
        e.round_ties_even() as i32,
        " ",
        d.trunc() as i32
    );
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
