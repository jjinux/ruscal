//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program GraphBkPalette;`
//! File: `graph_bk_palette.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// SetBkColor(c) makes colour 0 a copy of colour c as the palette has it
// now, so it follows an earlier SetPalette(c, ...) but not a later one,
// and SetBkColor(0) brings back black (the tests run with
// RUSCAL_GRAPH=headless). Expected output from Turbo Pascal 7 in DOSBox.

/// The main program: the `begin ... end.` block of `GraphBkPalette`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut driver: i16 = 0;
    let mut mode: i16 = 0;
    let mut p: PaletteType = PaletteType::default();
    driver = i16::from(VGA);
    mode = i16::from(VGA_HI);
    init_graph(&mut driver, &mut mode, "");
    set_palette(1, EGA_LIGHT_RED);
    set_bk_color(1);
    get_palette(&mut p);
    pwrite!(p.colors[0], " ", get_bk_color(), " ");
    set_bk_color(0);
    get_palette(&mut p);
    pwrite!(p.colors[0], " ");
    set_bk_color(2);
    set_palette(2, EGA_YELLOW);
    get_palette(&mut p);
    pwrite!(p.colors[0], " ", p.colors[2], " ", get_bk_color());
    close_graph();
    pwriteln!();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
