//! Generated by Ruscal from `sizeof_objects.pas`. Do not edit by hand.
//! Pascal: `program SizeOfObjects;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// SizeOf of objects and of records with fields of every kind, written as
// their SERIALIZED_SIZE constants. Expected output by hand, as Free
// Pascal's VMT field is 8 bytes and its Real 8: TBase is X, Y and TP's
// 2-byte VMT field (6); TChild adds a 6-byte Real (12); TPlain has no
// VMT (1); Mixed is 6 + 4 + 1 + 1 + 12 + 6 = 30; DateTime is 12.

/// Pascal: `TBase = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct TBase {
    x: i16,
    y: i16,
}

impl TBase {
    /// Pascal's `SizeOf(TBase)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    /// The last `2` is TP's hidden pointer to the object's virtual method table.
    pub const SERIALIZED_SIZE: usize = 2 + 2 + 2;
}

/// Pascal: `^TBase`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PBase = Ptr<AnyBase>;

/// Pascal: `object(TBase) Z: Real; procedure Draw; virtual; end`
#[derive(Clone, Copy, Debug, Default)]
struct TChild {
    /// The inherited part: `TChild` descends from `TBase`. Rust has no struct
    /// inheritance, so the parent object is embedded as a field, and inherited
    /// fields and methods are reached through it (`self.base.x`).
    base: TBase,
    z: f64,
}

impl TChild {
    /// Pascal's `SizeOf(TChild)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = TBase::SERIALIZED_SIZE + 6;
}

/// Pascal: `object A: Byte; procedure P; end`
#[derive(Clone, Copy, Debug, Default)]
struct TPlain {
    a: u8,
}

impl TPlain {
    /// Pascal's `SizeOf(TPlain)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = 1;
}

/// Pascal: `(Red, Green)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Color {
    #[default]
    Red,
    Green,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Color {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Color {
    const VALUES: &'static [Self] = &[Color::Red, Color::Green];
}

/// Pascal: `Mixed = record ... end`
#[derive(Clone, Debug, Default)]
struct Mixed {
    r: f64,
    p: Ptr<i16>,
    s: PSet<i8>,
    c: Color,
    when: DateTime,
    base: TBase,
}

impl Mixed {
    /// Pascal's `SizeOf(Mixed)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = 6 + 4 + 1 + 1 + 12 + TBase::SERIALIZED_SIZE;
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TBase {
    /// Pascal: `constructor TBase.Init;`
    fn init(&mut self) {
        self.x = 0;
    }
}

// Turbo Pascal finds a virtual method's version at run time, from the
// object's real type. Here each object type in the hierarchy has a trait
// like this one: its default methods are written once but run with `self`
// being the real object, so a call to a virtual method inside them goes to
// the right version. Each object implements the traits of its ancestors.
trait TBaseMethods {
    /// The `TBase` part of the object, for its fields.
    fn t_base(&mut self) -> &mut TBase;
    fn draw(&mut self);

    /// Pascal: `procedure TBase.Draw;`
    fn t_base_draw(&mut self) {
        pwriteln!("base");
    }
}

/// Every object of the `TBase` hierarchy, for pointers: a pointer to a
/// `TBase` may point to any object descended from it, so all of the
/// hierarchy's pointer types point to this enum. The variant says which object
/// the record really is, as Turbo Pascal's hidden table pointer did.
#[derive(Clone, Debug)]
enum AnyBase {
    Base(TBase),
    Child(TChild),
}

impl Default for AnyBase {
    fn default() -> Self {
        AnyBase::Base(TBase::default())
    }
}

impl AnyBase {
    /// The `TBase` part of the record.
    fn as_t_base(&self) -> &TBase {
        match self {
            AnyBase::Base(o) => o,
            AnyBase::Child(o) => &o.base,
        }
    }
    fn as_t_base_mut(&mut self) -> &mut TBase {
        match self {
            AnyBase::Base(o) => o,
            AnyBase::Child(o) => &mut o.base,
        }
    }
}

impl TBaseMethods for AnyBase {
    fn t_base(&mut self) -> &mut TBase {
        self.as_t_base_mut()
    }
    fn draw(&mut self) {
        match self {
            AnyBase::Base(o) => o.draw(),
            AnyBase::Child(o) => o.draw(),
        }
    }
}

impl TChildMethods for AnyBase {
    fn t_child(&mut self) -> &mut TChild {
        match self {
            AnyBase::Child(o) => o,
            _ => rte(204, "Invalid pointer operation: the record isn't a TChild"),
        }
    }
}

impl TBaseMethods for TBase {
    fn t_base(&mut self) -> &mut TBase {
        self
    }
    fn draw(&mut self) {
        self.t_base_draw()
    }
}

trait TChildMethods: TBaseMethods {
    /// The `TChild` part of the object, for its fields.
    fn t_child(&mut self) -> &mut TChild;

    /// Pascal: `procedure TChild.Draw;`
    fn t_child_draw(&mut self) {
        pwriteln!("child");
    }
}

impl TChildMethods for TChild {
    fn t_child(&mut self) -> &mut TChild {
        self
    }
}

impl TBaseMethods for TChild {
    fn t_base(&mut self) -> &mut TBase {
        &mut self.base
    }
    fn draw(&mut self) {
        self.t_child_draw()
    }
}

impl TPlain {
    /// Pascal: `procedure TPlain.P;`
    fn p(&mut self) {}
}

/// The main program: the `begin ... end.` block of `SizeOfObjects`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let c: TChild = TChild::default();
    let mut p: PBase = Ptr::nil();
    p = Ptr::new(AnyBase::Base(TBase::default()));
    p.get_mut().as_t_base_mut().init();
    p.get_mut().draw();
    pwriteln!(
        TBase::SERIALIZED_SIZE,
        " ",
        TChild::SERIALIZED_SIZE,
        " ",
        TChild::SERIALIZED_SIZE,
        " ",
        TPlain::SERIALIZED_SIZE
    );
    pwriteln!(Mixed::SERIALIZED_SIZE, " ", 12);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
