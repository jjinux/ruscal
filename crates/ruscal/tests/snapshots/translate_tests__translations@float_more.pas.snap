//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program FloatMore;`
//! File: `float_more.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// More Single, Double and Extended under $N+: in a variant record
// without a tag they keep TP's bytes (8 and 10, not a Real's 6), and an
// integer expression goes into a Single. Expected output from Turbo
// Pascal 7 in DOSBox.

/// Pascal: `TPun = record ... end`
///
/// A variant part without a tag field: TP programs use one to read the same
/// bytes as different types (set one variant's field, read another's). So
/// the record keeps those bytes, in TP's layout, and each of the variants'
/// fields reads or writes its slice of them.
#[derive(Clone, Copy, Debug, Default)]
struct TPun {
    variants: VariantPart<10>,
}

impl TPun {
    // `E` is bytes 0 to 9
    // (TP keeps it in 10 bytes, where an `f64` is a 6-byte `Real`)
    fn e(&self) -> f64 {
        self.variants.get_sized(0, Hint::new(10, 0))
    }
    fn set_e(&mut self, e: f64) {
        self.variants.set_sized(0, Hint::new(10, 0), e)
    }
    fn e_mut(&mut self) -> VariantField<'_, f64> {
        self.variants.field_sized(0, Hint::new(10, 0))
    }
    // `D` is bytes 0 to 7
    // (TP keeps it in 8 bytes, where an `f64` is a 6-byte `Real`)
    fn d(&self) -> f64 {
        self.variants.get_sized(0, Hint::new(8, 0))
    }
    fn set_d(&mut self, d: f64) {
        self.variants.set_sized(0, Hint::new(8, 0), d)
    }
    fn d_mut(&mut self) -> VariantField<'_, f64> {
        self.variants.field_sized(0, Hint::new(8, 0))
    }
    // `B` is bytes 0 to 9
    fn b(&self) -> PArray<u8, 0, 10> {
        self.variants.get(0)
    }
    fn set_b(&mut self, b: PArray<u8, 0, 10>) {
        self.variants.set(0, b)
    }
    fn b_mut(&mut self) -> VariantField<'_, PArray<u8, 0, 10>> {
        self.variants.field(0)
    }
}

impl TPun {
    /// Pascal's `SizeOf(TPun)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    /// The last term is the variant part: the bytes of its largest variant.
    pub const SERIALIZED_SIZE: usize = 10;
}

/// The main program: the `begin ... end.` block of `FloatMore`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: TPun = TPun::default();
    let mut s: f32 = 0.0;
    p = TPun::default();
    p.set_e(1.0);
    for i in 0_i16..=9 {
        pwrite!(i16::from(p.b()[i]), " ");
    }
    pwriteln!();
    p = TPun::default();
    p.set_d(1.0);
    for i in 0_i16..=9 {
        pwrite!(i16::from(p.b()[i]), " ");
    }
    pwriteln!();
    p.b_mut()[7] = 64;
    pwriteln!(wd(p.d(), 0, 1));
    s = (2 + 3) as f32;
    pwriteln!(wd(s, 0, 1), " ", TPun::SERIALIZED_SIZE);
    s = f32::from(TPun::SERIALIZED_SIZE as i16 * 2);
    pwriteln!(wd(s, 0, 1));
}

fn main() {
    // `{$N+}`: reals print as Turbo Pascal 7 printed them with the 8087,
    // with 15 digits (` 1.50000000000000E+0000`).
    ruscal_runtime::io::use_coprocessor_format();
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
