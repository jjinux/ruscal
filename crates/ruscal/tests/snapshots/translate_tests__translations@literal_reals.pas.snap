//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program LiteralReals;`
//! File: `literal_reals.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A real function of an expression made only of literals (Round(2.5 +
// 0.0), Sqrt(2.0 + 2.0)) is written as its value in the Rust, which can
// call a method on it; (2.5 + 0.0).round() wouldn't compile. Expected
// output from Turbo Pascal 7 in DOSBox.

const C: f64 = 2.5;

/// The main program: the `begin ... end.` block of `LiteralReals`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut l: i32 = 0;
    let mut r: f64 = 0.0;
    l = 2.5_f64.trunc() as i32;
    pwrite!(l, " ");
    l = 0.5_f64.round() as i32;
    pwrite!(l, " ");
    l = 3.0_f64.round() as i32;
    pwrite!(l, " ");
    l = (C + 0.5).round() as i32;
    pwriteln!(l);
    r = 4.0_f64.sqrt();
    pwriteln!(wd(r, 0, 1));
    r = 3.0_f64.trunc();
    pwriteln!(wd(r, 0, 1));
    r = (-1.5_f64).abs();
    pwriteln!(wd(r, 0, 1));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
