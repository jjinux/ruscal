//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program UntypedCasts;`
//! File: `untyped_casts.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Writes through a typecast of an untyped parameter: an element of a Word
// array, a record's field, Inc of one, and a string[5] as a whole (which
// takes 6 bytes, not a full string's 256), and one passed on to a var
// parameter, whole or a field (two in one statement too, of different
// parameters or of the same one), or to Val or Str; and read after a call
// changed it in the same statement. Output from fpc -Mtp.
/// Pascal: `array[0..127] of Word`
type TWords = PArray<u16, 0, 128>;

/// Pascal: `record a, b: Word; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    a: u16,
    b: u16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Rec { a, b });

/// Pascal: `record name: TName; n: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct NRec {
    name: PString,
    n: i16,
}

file_record!(NRec { name: string 5, n });

/// Pascal: `procedure SetWords(var Data);`
fn set_words(data: &mut dyn ByteView) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let mut data = Bytes::of(data);
    // Part of an untyped parameter seen as a `TWords`: its bytes are read into
    // `view`, which the statement changes, and written back after it.
    let mut view = data.read::<TWords>();
    view[0] = 1;
    data.write(&view);
    let mut view = data.read::<TWords>();
    view[1] = 2;
    data.write(&view);
}

/// Pascal: `procedure SetField(var Data);`
fn set_field(data: &mut dyn ByteView) {
    let mut data = Bytes::of(data);
    let mut view = data.read::<Rec>();
    view.b = 77;
    data.write(&view);
    let mut view = data.read::<Rec>();
    view.a += 10;
    data.write(&view);
}

/// Pascal: `procedure SetName(var Data; const s: string);`
fn set_name(data: &mut dyn ByteView, s: &PString) {
    let mut data = Bytes::of(data);
    data.write_string(&*s, 5);
}

/// Pascal: `procedure Add1(var n: Word);`
fn add1(n: &mut u16) {
    *n += 1;
}

/// Pascal: `procedure Bump(var Data);`
fn bump(data: &mut dyn ByteView) {
    let mut data = Bytes::of(data);
    let mut n = data.read::<u16>();
    add1(&mut n);
    data.write(&n);
    let mut view = data.read::<Rec>();
    add1(&mut view.b);
    data.write(&view);
}

/// Pascal: `function Next(var n: Word): Word;`
fn next(n: &mut u16) -> u16 {
    *n += 1;
    *n
}

/// Pascal: `procedure BumpBoth(var a; var b; var Sum: Word);`
fn bump_both(a: &mut dyn ByteView, b: &mut dyn ByteView, sum: &mut u16) {
    let mut a = Bytes::of(a);
    let mut b = Bytes::of(b);
    let mut n = a.read::<u16>();
    let mut n_2 = b.read::<u16>();
    *sum = next(&mut n) + next(&mut n_2);
    a.write(&n);
    b.write(&n_2);
}

/// Pascal: `procedure Swap2(var x, y: Word);`
fn swap2(x: &mut u16, y: &mut u16) {
    let mut t: u16 = 0;
    t = *x;
    *x = *y;
    *y = t;
}

/// Pascal: `procedure SwapBoth(var Data);`
fn swap_both(data: &mut dyn ByteView) {
    let mut data = Bytes::of(data);
    let mut view = data.read::<Rec>();
    swap2(&mut view.a, &mut view.b);
    data.write(&view);
}

/// Pascal: `function NextThenRead(var Data): Word;`
fn next_then_read(data: &mut dyn ByteView) -> u16 {
    let mut data = Bytes::of(data);
    let mut result: u16 = 0;
    let mut n = data.read::<u16>();
    result = next(&mut n) + n;
    data.write(&n);
    result
}

/// Pascal: `procedure Parse(var Data; const s: string);`
fn parse(data: &mut dyn ByteView, s: &PString) {
    let mut data = Bytes::of(data);
    let mut code: i16 = 0;
    let mut view = data.read::<u16>();
    val(s, &mut view, &mut code);
    data.write(&view);
}

/// Pascal: `procedure Show(var Data; n: Integer);`
fn show(data: &mut dyn ByteView, n: i16) {
    let mut data = Bytes::of(data);
    let mut view = data.read_string::<PString>(5);
    view = pas_str(n).truncated(5);
    data.write_string(&view, 5);
}

/// The main program: the `begin ... end.` block of `UntypedCasts`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut r: Rec = Rec::default();
    let mut nr: NRec = NRec::default();
    let mut w_: u16 = 0;
    let mut x: u16 = 0;
    let mut y: u16 = 0;
    r.a = 0;
    r.b = 0;
    set_words(&mut r);
    pwriteln!(r.a, " ", r.b);
    set_field(&mut r);
    pwriteln!(r.a, " ", r.b);
    nr.name = pstr("abc");
    nr.n = 258;
    set_name(&mut nr, &pstr("xy"));
    pwriteln!(nr.name, " ", nr.n);
    bump(&mut r);
    pwriteln!(r.a, " ", r.b);
    x = 1;
    y = 2;
    bump_both(&mut x, &mut y, &mut w_);
    pwriteln!(w_, " ", x, " ", y);
    parse(&mut bytes_from(&mut r, 0), &pstr("77"));
    show(&mut nr, 123);
    pwriteln!(r.a, " ", nr.name, " ", nr.n);
    r.a = 41;
    r.b = 42;
    swap_both(&mut r);
    pwriteln!(r.a, " ", r.b);
    x = 5;
    pwriteln!(next_then_read(&mut x), " ", x);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
