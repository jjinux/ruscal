//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program SizeOfOperators;`
//! File: `sizeof_operators.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// SizeOf (a cast in the Rust, Rec::SERIALIZED_SIZE as i16) at the end of
// the left side of < and in shl, and a Pascal function named like the
// runtime's serialized_string_size. Found by the Fable review of the
// SizeOf work. Output from fpc -Mtp.

/// Pascal: `packed record X, Y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Point {
    x: i16,
    y: i16,
}

impl Point {
    /// Pascal's `SizeOf(Point)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 2 + 2;
}

/// Pascal: `packed record Id: Integer; Name: string[3]; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    id: i16,
    name: PString,
}

impl Rec {
    /// Pascal's `SizeOf(Rec)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = 2 + serialized_string_size(3);
}

/// Pascal: `function Serialized_String_Size(N: Integer): Integer;`
fn serialized_string_size_(n: i16) -> i16 {
    let mut result: i16 = 0;
    result = n * 10;
    result
}

/// The main program: the `begin ... end.` block of `SizeOfOperators`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    i = 3;
    w_ = 5;
    pwriteln!((i - Rec::SERIALIZED_SIZE as i16) < 0, " ", (i + Rec::SERIALIZED_SIZE as i16) < 100);
    pwriteln!(
        (Point::SERIALIZED_SIZE as i16 - Rec::SERIALIZED_SIZE as i16) < 0,
        " ",
        (i * Rec::SERIALIZED_SIZE as i16) < 10
    );
    pwriteln!((i - w_ as i16) < 0);
    // `checked_shl`/`checked_shr`: shifting by the integer's width or more gives
    // 0, as in Turbo Pascal, where Rust's `<<` and `>>` would panic.
    pwriteln!(
        (Rec::SERIALIZED_SIZE as i16).checked_shl(i as u32).unwrap_or(0) < 1000,
        " ",
        (Rec::SERIALIZED_SIZE as i16).checked_shl(i as u32).unwrap_or(0)
    );
    pwriteln!(i16::MAX.checked_shr(i as u32).unwrap_or(0));
    pwriteln!(Rec::SERIALIZED_SIZE, " ", serialized_string_size_(2));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
