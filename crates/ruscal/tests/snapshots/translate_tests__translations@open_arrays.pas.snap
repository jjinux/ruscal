//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program OpenArrays;`
//! File: `open_arrays.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Open array parameters: &OpenArray<T> for a value or const one, &mut
// OpenArray<T> for a var one; an array argument is as_open(), one
// variable OpenArray::single, a string constant OpenArray::new; High is
// a.high(); a value one the routine changes is copied first; a nested
// routine and FillChar see it too.
const GREETING: &str = "hello";

/// Pascal: `record A: Integer; B: Char; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    a: i16,
    b: u8,
}

impl TRec {
    /// Pascal's `SizeOf(TRec)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 2 + 1;
}

/// Pascal: `function Sum(const A: array of Integer): LongInt;`
fn sum(a: &OpenArray<i16>) -> i32 {
    let mut result: i32 = 0;
    let mut t: i32 = 0;
    t = 0;
    for i in 0..=a.high() as i16 {
        t += i32::from(a[i]);
    }
    result = t;
    result
}

/// Pascal: `procedure Twice(var A: array of Integer);`
fn twice(a: &mut OpenArray<i16>) {
    twice_double_first(a);
    pwriteln!(sum(a));
}

/// Pascal: `procedure DoubleFirst;`
///
/// Nested inside `Twice` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn twice_double_first(a: &mut OpenArray<i16>) {
    a[0] *= 2;
}

/// Pascal: `procedure Local(A: array of Integer);`
fn local(a: &OpenArray<i16>) {
    // `a` is a value parameter, which this routine changes: in Pascal
    // that's its own copy of the caller's array.
    let mut a_copy = a.to_vec();
    let a = OpenArray::new_mut(&mut a_copy);
    a[0] = 0;
    pwriteln!(sum(a), " ", (a.len() * 2) as i16);
}

/// Pascal: `procedure Count(const C: array of Char);`
fn count(c: &OpenArray<u8>) {
    pwriteln!(c.high() as i16 + 1);
}

/// Pascal: `procedure Clear(var R: array of TRec);`
fn clear(r: &mut OpenArray<TRec>) {
    let size = (r.len() * TRec::SERIALIZED_SIZE) as i16;
    fill_bytes(&mut open_bytes(r), size, 0);
}

/// The main program: the `begin ... end.` block of `OpenArrays`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut scores: PArray<i16, 1, 3> = PArray::default();
    let mut recs: PArray<TRec, 0, 2> = PArray::default();
    let mut n: i16 = 0;
    scores[1] = 1;
    scores[2] = 2;
    scores[3] = 3;
    n = 4;
    pwriteln!(sum(scores.as_open()), " ", sum(OpenArray::single(&n)));
    twice(scores.as_open_mut());
    twice(OpenArray::single_mut(&mut n));
    local(scores.as_open());
    count(OpenArray::new(b"xyz"));
    count(OpenArray::new(GREETING.as_bytes()));
    clear(recs.as_open_mut());
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
