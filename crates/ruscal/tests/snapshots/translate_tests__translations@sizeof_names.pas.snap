//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program SizeOfNames;`
//! File: `sizeof_names.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// SizeOf of the program's records is written as the record's
// SERIALIZED_SIZE constant, built from its fields, so the Rust says
// where the number comes from. Output from fpc -Mtp.

const NAME_LEN: i16 = 10;
const TWICE: i16 = Rec::SERIALIZED_SIZE as i16 * 2;
const TOTAL: i16 = Rec::SERIALIZED_SIZE as i16 + NAME_LEN;

/// Pascal: `packed record X, Y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Point {
    x: i16,
    y: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Point { x, y });

impl Point {
    /// Pascal's `SizeOf(Point)`: its bytes in Turbo Pascal's layout.
    /// That's also what a typed file stores, so it's called the serialized
    /// size; the Rust value's size in memory (`std::mem::size_of`) differs.
    pub const SERIALIZED_SIZE: usize = 2 + 2;
}

/// Pascal: `(Circle, Square)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Shape {
    #[default]
    Circle,
    Square,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Shape {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Shape {
    const VALUES: &'static [Self] = &[Shape::Circle, Shape::Square];
}

/// Pascal: `Rec = record ... end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    id: i16,
    name: PString,
    corners: PArray<Point, 1, 3>,
}

file_record!(Rec { id, name: string 10, corners });

impl Rec {
    /// Pascal's `SizeOf(Rec)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = 2 + serialized_string_size(10) + 3 * Point::SERIALIZED_SIZE;
}

/// Pascal: `Variant = record ... end`
///
/// The `case Kind: ... of` part is a tagged union: the program sets `kind`
/// to say which variant's fields are in use. Rust would use an `enum`, but
/// Pascal lets a program set the fields before the tag, so every variant's
/// fields are plain fields here; only `file of` looks at the tag.
#[derive(Clone, Copy, Debug, Default)]
struct Variant {
    tag: u8,
    kind: Shape,
    radius: i16,
    side: i32,
    fill: u8,
}

impl Variant {
    /// Pascal's `SizeOf(Variant)`: its bytes in Turbo Pascal's layout.
    /// The last term is the variant part: the bytes of its largest variant.
    pub const SERIALIZED_SIZE: usize = 1 + 1 + 5;
}

/// Pascal: `array[1..SizeOf(Point)] of Byte`
type Bytes_ = PArray<u8, 1, 4>;

/// Pascal: `array[1..2] of Rec`
type Pair = PArray<Rec, 1, 2>;

/// Pascal: `packed record A: Integer; S: string[5]; end`
#[derive(Clone, Copy, Debug, Default)]
struct Anon {
    a: i16,
    s: PString,
}

impl Anon {
    /// Pascal's `SizeOf(Anon)`: its bytes in Turbo Pascal's layout.
    pub const SERIALIZED_SIZE: usize = 2 + serialized_string_size(5);
}

/// Pascal: `procedure Show(N: Integer);`
fn show(n: i16) {
    pwrite!(n, " ");
}

/// The main program: the `begin ... end.` block of `SizeOfNames`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let typed: i16 = Variant::SERIALIZED_SIZE as i16;
    let mut r: Rec = Rec::default();
    let ps: Pair = Pair::default();
    let b: Bytes_ = Bytes_::default();
    let anon: Anon = Anon::default();
    let mut w_: u16 = 0;
    let mut l: i32 = 0;
    let mut count: i16 = 0;
    let mut f: PBlockFile = PBlockFile::default();
    pwriteln!(
        Rec::SERIALIZED_SIZE,
        " ",
        Rec::SERIALIZED_SIZE,
        " ",
        serialized_string_size(10),
        " ",
        Point::SERIALIZED_SIZE
    );
    pwriteln!(
        Variant::SERIALIZED_SIZE,
        " ",
        2 * Rec::SERIALIZED_SIZE,
        " ",
        2 * Rec::SERIALIZED_SIZE,
        " ",
        Anon::SERIALIZED_SIZE
    );
    pwriteln!(TWICE, " ", TOTAL, " ", typed, " ", 2, " ", b.high());
    pwriteln!(ps.high() + 25, " ", Rec::SERIALIZED_SIZE as i16 - Point::SERIALIZED_SIZE as i16 * 2);
    w_ = Rec::SERIALIZED_SIZE as u16;
    l = (2 * Rec::SERIALIZED_SIZE) as i32 * 1000;
    show(w_ as i16);
    show(l as i16);
    show(Variant::SERIALIZED_SIZE as i16);
    pwriteln!();
    if Rec::SERIALIZED_SIZE as i16 > 20 {
        pwriteln!("big");
    }
    match 4 {
        value if value == Point::SERIALIZED_SIZE as i16 => {
            pwriteln!("point-sized");
        }
        _ => {
            pwriteln!("other");
        }
    }
    count = 0;
    for i in 1_i16..=Point::SERIALIZED_SIZE as i16 {
        count += 1;
    }
    pwriteln!(count);
    r = Rec::default();
    pwriteln!(r.id, " ", r.name.length());
    r.id = 7;
    r.name = pstr("seven");
    f.assign("sizeof_names.dat");
    f.rewrite_records(1);
    f.block_write(&r.to_bytes(), 25);
    pwriteln!(f.file_size() / Rec::SERIALIZED_SIZE as i32);
    f.close();
    f.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
