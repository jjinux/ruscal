//! Generated by the Ruscal Turbo Pascal to Rust transpiler
//! Pascal: `program IndexReadsTarget;`
//! File: `index_reads_target.pas`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// An index into the variable being changed that reads that variable
// (A[High(A)] := 1, S[Length(S)] := 'z'): worked out first, so Rust
// doesn't borrow the variable twice. Output from fpc -Mtp.

const K: i16 = 6;

/// The main program: the `begin ... end.` block of `IndexReadsTarget`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut a: PArray<u8, 0, 1001> = PArray::default();
    let mut b: PArray<i16, 1, 5> = PArray::default();
    let mut s: PString = PString::new();
    let rsc_index = a.high();
    a[rsc_index] = 1;
    let rsc_index = a.high() - 1;
    a[rsc_index] = 2;
    let rsc_index = K + a.high() as i16 - 1000;
    a[rsc_index] = 3;
    let rsc_index = b.low();
    b[rsc_index] = 7;
    let rsc_index = b.high();
    b[rsc_index] += 5;
    let rsc_index = b.high();
    b[rsc_index] += 1;
    s = pstr("abc");
    let rsc_index = s.length();
    s[rsc_index] = b'z';
    let rsc_index = a[1000];
    a[rsc_index] = 9;
    let rsc_index = b[1] - 6;
    b[rsc_index] = 4;
    pwriteln!(
        i16::from(a[1000]),
        i16::from(a[999]),
        i16::from(a[6]),
        " ",
        i16::from(a[1]),
        " ",
        b[1],
        " ",
        b[5],
        " ",
        s
    );
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
